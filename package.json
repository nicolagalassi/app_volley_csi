{
  "name": "app-volley-csi",
  "version": "1.0.0",
  "private": true,
  "description": "Partite, risultati e classifica della Fulgur dai calendari PDF del CSI",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "data": "node tools/parse-pdf.mjs tests/fixtures/calendario-open-misto-eccellenza.pdf > data/campionati.json",
    "start": "npx --yes http-server@14.1.1 -c-1 -p 8080 .",
    "build": "node tools/build.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "pdfjs-dist": "4.10.38",
    "wrangler": "^4.163.0"
  }
}
